# ===== COPIE ESTE ARQUIVO PARA ".env" E PREENCHA =====

# --- IA (obrigatório) ---
GROQ_API_KEY=cole_sua_chave_da_groq

# --- Segurança (obrigatório em produção) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=

# --- Porta (opcional; hospedagens definem sozinhas) ---
PORT=3001

# --- Banco de dados ---
# Vazio  = salva em arquivos JSON locais (ótimo para desenvolver no seu PC)
# Preenchido = usa PostgreSQL (OBRIGATÓRIO na hospedagem gratuita, onde os arquivos são apagados)
# Exemplo Neon: postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- E-mail de recuperação de senha ---
# Escolha UM modo:
#
# (a) Gmail (só funciona no seu PC e em hospedagens que liberam SMTP):
EMAIL_USER=
EMAIL_PASS=
#
# (b) Brevo por API HTTP (funciona na hospedagem gratuita, onde SMTP é bloqueado):
#     EMAIL_PROVIDER=brevo
#     BREVO_API_KEY=
#     EMAIL_FROM=e-mail_remetente_verificado_no_brevo@exemplo.com
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM=
#
# (c) Teste sem enviar nada de verdade (o código aparece no terminal):
#     EMAIL_TEST=true
EMAIL_TEST=

# --- Sites autorizados a chamar a API (só se o site ficar em OUTRO endereço) ---
# Ex.: https://meusite.pages.dev,https://outrodominio.com
ALLOWED_ORIGINS=

# development | production
NODE_ENV=development
